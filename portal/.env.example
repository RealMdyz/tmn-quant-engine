# TMN Portal settings. On Liara: app -> settings -> environment variables. NEVER commit real values.
# (comments are on their own lines so the file also works with `docker run --env-file`)

# ---- required
# long random string: python -c "import secrets; print(secrets.token_hex(32))"
PORTAL_SECRET=
PUBLIC_URL=https://<portal-app>.liara.run
# your founder login (password: at least 8 characters, letters + digits)
FOUNDER_EMAIL=
FOUNDER_PASSWORD=

# ---- the real bot and the real Wallex account (founder control room)
# the bot app's existing status page on Liara
BOT_STATUS_URL=https://<bot-app>.liara.run
# read-only use: balances, open orders, trades (a separate read-only key is better if Wallex offers one)
WALLEX_API_KEY=
# optional: full equity/sleeve history from the runtime-logs branch
GITHUB_TOKEN=
GITHUB_REPO=RealMdyz/tmn-quant-engine

# ---- users' bots: wallex = live prices | replay = offline demo on data/hourly.json
MARKET_SOURCE=wallex
TICK_SECONDS=60
SNAPSHOT_EVERY_S=300

# ---- payments: demo = instant test payment | zarinpal
PAYMENT_PROVIDER=demo
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0

# ---- optional
# PostgreSQL instead of SQLite (also: pip install "psycopg[binary]")
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/portal
# demo investors for a showcase server; never on the real platform
# SEED_DEMO=1
